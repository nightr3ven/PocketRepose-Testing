{
	"schemaVersion": 1,
	"id": "pocket-repose",
	"version": "${version}",
	"name": "Pocket Repose",
	"description": "A mod created for explorers in need of a trustworthy home.",
	"authors": [
		"BennyBoops"
	],
	"contact": {
		"homepage": "https://github.com/BennyBoops/PocketRepose",
		"sources": "https://github.com/BennyBoops/PocketRepose"
	},
	"license": "MIT",
	"icon": "assets/pocket-repose/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.bennyboops.modid.PocketRepose"
		],
		"client": [
			"net.bennyboops.modid.PocketReposeClient"
		]
	},
	"mixins": [
		"pocket-repose.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": ">=0.159.0",
		"fantasy": ">=0.8.3"
	},

	"custom": {
		"fabric-dimensions:use_custom_dimensions": true
	}
}
